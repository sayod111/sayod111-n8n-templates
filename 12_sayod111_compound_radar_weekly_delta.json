        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer dp_live_REPLACE_WITH_YOUR_KEY"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        }
      },
      "id": "2",
      "name": "Fetch Sayod 111 E-Com Radar (Edge D1)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "data"
      },
      "id": "3",
      "name": "Split Records",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        720,
        300
      ]
    }
  ],
  "connections": {
    "Weekly Monday Trigger": {
      "main": [
        [
          {
            "node": "Fetch Sayod 111 E-Com Radar (Edge D1)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Sayod 111 E-Com Radar (Edge D1)": {
      "main": [
        [
          {
            "node": "Split Records",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}